@page "/"

<PageTitle>Shop</PageTitle>

<div class="shop-container">

    <section class="hero">
        <h1>MY SHOP</h1>

        <p>
            Khám phá những sản phẩm mới nhất
        </p>

        <button class="shop-button">
            Mua sắm ngay
        </button>
    </section>


    <section class="products">

        <h2>Sản phẩm nổi bật</h2>

        <div class="product-grid">

            <div class="product-card">

                <div class="product-image">
                    PRODUCT IMAGE
                </div>

                <h3>Nike Air Max</h3>

                <p>Giày thể thao Nike Air Max</p>

                <strong>2.490.000 đ</strong>

                <button>
                    Thêm vào giỏ
                </button>

            </div>


            <div class="product-card">

                <div class="product-image">
                    PRODUCT IMAGE
                </div>

                <h3>Adidas Ultraboost</h3>

                <p>Giày chạy bộ Adidas</p>

                <strong>3.200.000 đ</strong>

                <button>
                    Thêm vào giỏ
                </button>

            </div>


            <div class="product-card">

                <div class="product-image">
                    PRODUCT IMAGE
                </div>

                <h3>New Balance 530</h3>

                <p>Phong cách retro</p>

                <strong>2.100.000 đ</strong>

                <button>
                    Thêm vào giỏ
                </button>

            </div>

        </div>

    </section>

</div>